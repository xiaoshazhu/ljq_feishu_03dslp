# 正式生产配置。
NODE_ENV=production
PORT=3004

# 前端配置台公网地址；后端自身本地聚合默认走 http://127.0.0.1:${PORT}，这里不用配。
FRONTEND_PUBLIC_URL=https://dd.feishu.anhuishuzhi.com

# 飞书 Verification token 和管理网关 HMAC 密钥。
REQUIRE_FEISHU_SIGNATURE=true
SECRET_KEY=replace-with-feishu-verification-token
MANAGEMENT_IDENTITY_AUTH_MODE=gateway_hmac
MANAGEMENT_IDENTITY_SECRET=replace-with-independent-gateway-hmac-secret

# 同一抖店账号最多同时执行的同步请求数。
SYNC_ACCOUNT_CONCURRENCY=10

# 数据库连接。
MYSQL_HOST=rm-2vc97xlt88l07n30ioo.mysql.cn-chengdu.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yanyuanwangYYW770!
MYSQL_DATABASE=feishu_connector_dd
# 抖店 Cookie 加密密钥；测试和正式共用同一数据库时必须保持一致。
CREDENTIAL_ENCRYPTION_KEY=8d708478042e0efe0ac0e0f754152e6252947ab442dd4521e93e2af530caa0d8
#单次最大
UPSTREAM_RESPONSE_MAX_BYTES=10485760
# 运行环境
NODE_ENV=production
PORT=3000
FRONTEND_PUBLIC_URL=https://connector.example.com
FRONTEND_DEV_SERVER=http://127.0.0.1:5173
TRUST_PROXY_HOPS=1

# 管理 API 可信身份网关
MANAGEMENT_IDENTITY_AUTH_MODE=gateway_hmac
MANAGEMENT_IDENTITY_SECRET=replace-with-an-independent-32-character-secret
MANAGEMENT_IDENTITY_MAX_AGE_MS=30000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=connector
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=feishu_connector
MYSQL_CONNECTION_LIMIT=20
MYSQL_MAX_IDLE_CONNECTIONS=20
MYSQL_QUEUE_LIMIT=500
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_IDLE_TIMEOUT_MS=60000
MYSQL_HEALTH_QUERY_TIMEOUT_MS=2000
MYSQL_MIGRATION_LOCK_TIMEOUT_MS=30000

# 飞书请求签名
SECRET_KEY=replace-with-feishu-secret-key
REQUIRE_FEISHU_SIGNATURE=true
# 官方签名规范未要求时间窗口，默认关闭；确认服务器时钟同步后可按需开启。
FEISHU_SIGNATURE_MAX_AGE_MS=0

# 凭证加密与内部调用
# 使用 32 字节随机值的 64 位十六进制或标准 Base64。
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-random-key
LOCAL_AGGREGATE_TOKEN=replace-with-an-independent-32-character-token
LOCAL_AGGREGATE_BASE_URL=http://127.0.0.1:3000
ALLOW_REMOTE_LOCAL_AGGREGATE=false
CREDENTIAL_MAX_BYTES=65535
CAPTURE_SESSION_TTL_MS=900000

# 抖店来源与主动请求白名单
DOUDIAN_CAPTURE_ALLOWED_ORIGINS=https://fxg.jinritemai.com,https://compass.jinritemai.com
DOUDIAN_ALLOWED_API_ORIGINS=https://fxg.jinritemai.com,https://compass.jinritemai.com
ALLOW_MOCK_DATA=false

# 同步容量
MAX_SYNC_PAGE_SIZE=200
SYNC_GLOBAL_CONCURRENCY=40
SYNC_COMPANY_CONCURRENCY=10
SYNC_ACCOUNT_CONCURRENCY=1
SYNC_GLOBAL_QUEUE_LIMIT=200
SYNC_COMPANY_QUEUE_LIMIT=50
SYNC_ACCOUNT_QUEUE_LIMIT=20
SYNC_QUEUE_TIMEOUT_MS=1500
SYNC_ACCOUNT_START_INTERVAL_MS=200

# HTTP 与飞书接口截止时间
JSON_BODY_LIMIT=1mb
TABLE_META_DEADLINE_MS=8000
RECORDS_DEADLINE_MS=18000
HTTP_REQUEST_TIMEOUT_MS=25000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
HTTP_COMPRESSION_THRESHOLD_BYTES=1024
UPSTREAM_RESPONSE_MAX_BYTES=104857600
SHUTDOWN_TIMEOUT_MS=10000

# 管理接口保护
CAPTURE_RATE_LIMIT_PER_MINUTE=20
MANAGEMENT_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_MAX_BUCKETS=10000
